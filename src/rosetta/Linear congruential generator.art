define :lcg [
    init: method [seed, multiplier, increment, divisor][
        \state: seed
        \multiplier: multiplier
        \increment: increment
        \divisor: divisor
    ]

    rand: method [][
        \state: (\increment + \multiplier * \state) % 2^31
        \state / \divisor
    ]
]

bsd: to :lcg [0 1103515245 12345 1]
ms:  to :lcg [0 214013 2531011 2^16]

print "BSD rand(), seed 0:"
loop 1..10 'x -> print bsd\rand

print ""
print "Microsoft rand(), seed 0:"
loop 1..10 'x -> print ms\rand
