consolidate: function [sets][
    result: []
    loop sets 's [
        overlapping: select result 'r -> not? empty? intersection r s
        apart: select result 'r -> empty? intersection r s
        result: apart ++ @[fold overlapping .seed: s => union]
    ]
    result
]

showSet: function [s]->
    "{" ++ (join.with:", " to [:string] s) ++ "}"

loop [
    [[A B] [C D]]
    [[A B] [B D]]
    [[A B] [C D] [D B]]
    [[H I K] [A B] [C D] [D B] [F G H]]
] 'sets ->
    print [
        join.with:", " map sets => showSet
        "->"
        join.with:", " map consolidate sets => showSet
    ]
