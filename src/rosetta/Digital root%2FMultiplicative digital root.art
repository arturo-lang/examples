mdr: function [n][
    m: n
    persistence: 0
    while [m > 9][
        m: product digits m
        inc 'persistence
    ]
    @[persistence, m]
]

print "Number   MP  MDR"
loop [123321 7739 893 899998] 'n [
    [mp, root]: mdr n
    print [
        pad to :string n 6
        pad to :string mp 4
        pad to :string root 4
    ]
]

print ""
print "MDR: [n0..n4]"
table: #[]
loop 0..9 'r -> table\[r]: []

n: 0
while [some? values table 'found -> 5 > size found][
    root: last mdr n
    if 5 > size table\[root] ->
        table\[root]: table\[root] ++ n
    n: n + 1
]
loop 0..9 'r ->
    print [pad to :string r 3 ":" table\[r]]
