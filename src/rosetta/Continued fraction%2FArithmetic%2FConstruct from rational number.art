r2cf: function [a, b][
    result: []
    while [not? zero? b][
        q: a / b
        r: a - q * b
        if r < 0 [
            q: dec q
            r: r + b
        ]
        'result ++ q
        a: b
        b: r
    ]
    result
]

tests: @[
    1         2
    3         1
    23        8
    13        11
    22        7
    neg 151   77
    14142     10000
    141421    100000
    1414214   1000000
    14142136  10000000
]

loop tests [n, d] ->
    print [pad ~"|n|/|d|" 18 "->" r2cf n d]
