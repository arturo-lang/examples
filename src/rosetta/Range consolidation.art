consolidate: function [ranges][
    result: []
    loop arrange map ranges => sort 'r -> first r 'r [
        overlaps?: and? -> not? empty? result
                        -> (first r) =< last last result
        switch overlaps? [
            lastRange: last result
            result\[dec size result]: @[first lastRange, max @[last lastRange, last r]]
        ][
            'result ++ @[r]
        ]
    ]
    result
]

showRanges: function [ranges]->
    join.with:", " map ranges 'r ->
        "[" ++ (join.with:", " to [:string] r) ++ "]"

loop @[
    [[1.1 2.2]]
    [[6.1 7.2] [7.2 8.3]]
    [[4 3] [2 1]]
    @[[4 3] [2 1] @[neg 1 neg 2] [3.9 10]]
    @[[1 3] @[neg 6 neg 1] @[neg 4 neg 5] [8 2] @[neg 6 neg 6]]
] 'ranges ->
    print [
        pad showRanges ranges 45
        "=>"
        showRanges consolidate ranges
    ]
