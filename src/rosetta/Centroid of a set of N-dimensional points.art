centroid: function [points]->
    map 0..dec size first points 'd ->
        average map points 'p -> p\[d]

loop @[
    [[1] [2] [3]]
    [[8 2] [0 0]]
    [[5 5 0] [10 10 0]]
    @[[1 3.1 6.5] @[neg 2 neg 5 3.4] @[neg 7 neg 4 9] [2 0 3]]
    [[0 0 0 0 1] [0 0 0 1 0] [0 0 1 0 0] [0 1 0 0 0]]
] 'points ->
    print [points "->" centroid points]
