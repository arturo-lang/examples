p: function [l, n][
    nd:   size to :string l
    low:  (log l 10) - nd - 1
    high: (log l + 1 10) - nd - 1
    lg2:  log 2 10
    count: 0
    j: 0
    while [count < n][
        j: inc j
        f: (j * lg2) - floor j * lg2
        if and? f >= low f < high -> count: inc count
    ]
    j
]

tests: [
    12  1
    12  2
    123 45
    123 12345
    123 678910
]

loop tests [l, n] ->
    print [~"p(|l|, |n|) =" p l n]
