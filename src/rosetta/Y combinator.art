Y: function [f][
    g: function [x] with 'f [
        call 'f @[function [y] with 'x [
            call (call 'x @[var 'x]) @[y]
        ]]
    ]
    call 'g @[var 'g]
]

almostFactorial: function [self][
    function [n] with 'self [
        (n < 2)? -> 1
                 -> n * call 'self @[dec n]
    ]
]

almostFibonacci: function [self][
    function [n] with 'self [
        (n < 2)? -> n
                 -> (call 'self @[dec n]) + call 'self @[n-2]
    ]
]

factorial: Y var 'almostFactorial
fibonacci: Y var 'almostFibonacci

factorials: map 1..10 'n -> call 'factorial @[n]
fibonaccis: map 1..10 'n -> call 'fibonacci @[n]

print ["factorials:" factorials]
print ["fibonacci: " fibonaccis]
