ownCalcPass: function [password, nonce][
    start: true
    num1: 0
    num2: 0
    password: to :integer password
    loop nonce 'c [
        if c <> '0' [
            if start -> num2: password
            start: false
        ]
        case c [
            '1' [
                num1: shr and num2 0xFFFFFF80 7
                num2: shl num2 25
            ]
            '2' [
                num1: shr and num2 0xFFFFFFF0 4
                num2: shl num2 28
            ]
            '3' [
                num1: shr and num2 0xFFFFFFF8 3
                num2: shl num2 29
            ]
            '4' [
                num1: shl num2 1
                num2: shr num2 31
            ]
            '5' [
                num1: shl num2 5
                num2: shr num2 27
            ]
            '6' [
                num1: shl num2 12
                num2: shr num2 20
            ]
            '7' [
                num1: or or and num2 0x0000FF00
                            shl and num2 0x000000FF 24
                         shr and num2 0x00FF0000 16
                num2: shr and num2 0xFF000000 8
            ]
            '8' [
                num1: or shl and num2 0x0000FFFF 16
                         shr num2 24
                num2: shr and num2 0x00FF0000 8
            ]
            '9' [num1: not num2]
            any [num1: num2]
        ]
        num1: and num1 0xFFFFFFFF
        num2: and num2 0xFFFFFFFF
        unless contains? "09" c ->
            num1: or num1 num2
        num2: num1
    ]
    num1
]

tests: [
    "12345" "603356072" 25280520
    "12345" "410501656" 119537670
    "12345" "630292165" 4269684735
]

loop tests [pass, nonce, expected][
    result: ownCalcPass pass nonce
    status: (result = expected)? -> "PASS" -> "FAIL"
    print [status pass nonce result expected]
]
