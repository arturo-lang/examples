ranks: 1..13
suits: ['♣', '♦', '♥', '♠']

rank?: $ => [in? & ranks]
suit?: $ => [in? & suits]

interleave: $[
    xs :block :dictionary :range
    ys :block :dictionary :range 
    apply :literal
][
    flatten map xs 'x 
        -> map ys 'y 
        -> call apply @[x y]
]

define :Card [
    init: method [rank, suit][
        ensure -> rank? rank
        ensure -> suit? suit

        this\rank: rank
        this\suit: suit
    ]

    string: method [][
        R: case this\rank [
            1       -> 'A'
            11      -> 'J'
            12      -> 'Q'
            13      -> 'K'
            any     -> this\rank
        ]
        ~{|R||this\suit|}
    ]
]

card: $[rank suit][
    to :Card [rank suit]
]

define :Deck [
    init: method [][
        this\cards: interleave ranks suits 'card
    ]
]

shuffleUp: function [this :Deck][
    this\cards: shuffle this\cards
]

deal: function [this :Deck, cnt :integer][
    if cnt > size this\cards ->
        panic "Not enough cards in deck"

    cards: []
    do.times: cnt [
        dealt: sample this\cards
        'cards ++ dealt
        this\cards: remove this\cards dealt
    ]
    return cards
]

; create a new deck
Deck: to :Deck []

; and shuffle it
shuffleUp Deck

; deal 5 cards
print deal Deck 5
