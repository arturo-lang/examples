perpendicularDistance: function [p, a, b][
    dx: b\0 - a\0
    dy: b\1 - a\1
    (abs ((dy * p\0) - (dx * p\1)) + (b\0 * a\1) - b\1 * a\0) / sqrt (dx * dx) + dy * dy
]

rdp: function [points, epsilon][
    if 3 > size points -> return points
    a: first points
    b: last points
    distances: map points 'p ->
        perpendicularDistance p a b
    furthest: index distances max distances
    if (max distances) =< epsilon -> return @[a b]
    left: rdp points\[0..furthest] epsilon
    right: rdp points\[furthest..dec size points] epsilon
    (chop left) ++ right
]

line: @[
    [0 0] [1 0.1] @[2 neg 0.1] [3 5] [4 6]
    [5 7] [6 8.1] [7 9] [8 9] [9 9]
]

print rdp line 1.0
