applyFilter: function [a, b, signal][
    result: []
    loop 0..dec size signal 'i [
        forward: sum map 0..dec size b 'j ->
            (i >= j)? -> b\[j] * signal\[i-j] -> 0
        feedback: sum map 1..dec size a 'j ->
            (i >= j)? -> a\[j] * result\[i-j] -> 0
        'result ++ (forward - feedback) / a\0
    ]
    result
]

a: @[1.00000000 neg 2.77555756e-16 3.33333333e-01 neg 1.85037171e-17]
b: [0.16666667 0.5 0.5 0.16666667]

signal: @[
    neg 0.917843918645      0.141984778794      1.20536903482       0.190286794412
    neg 0.662370894973  neg 1.00700480494   neg 0.404707073677      0.800482325044
        0.743500089861      1.01090520172       0.741527555207      0.277841675195
        0.400833448236  neg 0.2085993586    neg 0.172842103641  neg 0.134316096293
        0.0259303398477     0.490105989562      0.549391221511      0.9047198589
]

loop split.every: 5 applyFilter a b signal 'row ->
    print join.with:", " map row 'y -> pad to :string .format:".8f" y 11
