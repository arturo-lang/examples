side: function [p, a, b]->
    ((p\0 - b\0) * a\1 - b\1) - (a\0 - b\0) * p\1 - b\1

inTriangle?: function [p, a, b, c][
    d1: side p a b
    d2: side p b c
    d3: side p c a
    hasNegative: some? @[d1 d2 d3] => negative?
    hasPositive: some? @[d1 d2 d3] => positive?
    not? and? hasNegative hasPositive
]

triangle: @[[1.5 2.4] @[5.1 neg 3.1] @[neg 3.8 1.2]]

loop [[0 0] [0 1] [3 1]] 'p ->
    print [
        "Point" p "within" triangle "?"
        inTriangle? p triangle\0 triangle\1 triangle\2
    ]

print ""
p: [5.414285714285714 14.349206349206348]
a: [0.1 0.1111111111111111]
b: [12.5 33.333333333333336]

loop @[[25.0 11.11111111111111] @[neg 12.5 16.666666666666668]] 'c ->
    print [
        "Point" p "within" @[a b c] "?"
        inTriangle? p a b c
    ]
