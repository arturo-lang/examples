brent: function [f, x0][
    power: 1
    lam: 1
    tortoise: x0
    hare: f x0
    while [tortoise <> hare][
        if power = lam [
            tortoise: hare
            power: 2 * power
            lam: 0
        ]
        hare: f hare
        lam: inc lam
    ]

    tortoise: x0
    hare: x0
    do.times: lam ->
        hare: f hare

    mu: 0
    while [tortoise <> hare][
        tortoise: f tortoise
        hare: f hare
        mu: inc mu
    ]
    @[lam mu]
]

iterated: function [x]-> (inc x * x) % 255

sequence: [3]
do.times: 40 ->
    'sequence ++ iterated last sequence
print join.with:"," to [:string] sequence

[lam, mu]: brent var 'iterated 3
print ["Cycle length =" lam]
print ["Start index =" mu]
print ["Cycle:" slice sequence mu dec mu + lam]
