earthRadius: 6371000.0
step: 0.001
far: 10000000.0

rho: function [h]->
    exp neg h / 8500.0

height: function [a, z, d][
    r: earthRadius + a
    (sqrt ((r * r) + d * d) - 2 * d * r * cos (180 - z) * pi / 180) - earthRadius
]

columnDensity: function [a, z][
    total: 0.0
    d: 0.0
    while [d < far][
        delta: max @[step, step * d]
        total: total + delta * rho height a z d + 0.5 * delta
        d: d + delta
    ]
    total
]

airMass: function [a, z]->
    (columnDensity a z) / columnDensity a 0

print "Angle           0 m          13700 m"
print "------------------------------------"
loop range.step: 5 0 90 'z ->
    print [
        pad to :string z 3
        pad to :string .format:".7f" airMass 0 z 17
        pad to :string .format:".7f" airMass 13700 z 16
    ]
