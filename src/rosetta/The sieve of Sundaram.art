sundaram: function [limit][
    k: to :integer (limit * (ln limit) + ln ln limit) / 2
    k: max @[k 100]
    marked: array.of: inc k false
    loop 1..k 'i [
        step: inc 2*i
        j: i + i*step
        if j > k -> break
        while [j =< k][
            marked\[j]: true
            j: j + step
        ]
    ]
    unmarked: select 1..k 'n -> not? marked\[n]
    first.n: limit map unmarked 'n -> inc 2*n
]

primes: sundaram 1000000

print "The first 100 odd primes generated by the Sieve of Sundaram:"
loop split.every: 10 first.n: 100 primes 'row ->
    print map row 'p -> pad to :string p 4

print ""
print ["The millionth odd prime is:" last primes]
