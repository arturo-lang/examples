longPrime?: function [p][
    if p < 7 -> return false
    every? unique factors.prime p-1 'q ->
        1 <> powmod 10 (p-1)/q p
]

longPrimes: select 2..64000 'p ->
    and? -> prime? p
         -> longPrime? p

print "Long primes up to 500:"
print select longPrimes => [& =< 500]

print ""
loop [500 1000 2000 4000 8000 16000 32000 64000] 'limit ->
    print [
        "Number of long primes up to"
        (pad to :string limit 5) ++ ":"
        size select longPrimes => [& =< limit]
    ]
