menPrefs: #[
    abe:  [abi eve cath ivy jan dee fay bea hope gay]
    bob:  [cath hope abi dee eve fay bea jan ivy gay]
    col:  [hope eve abi dee bea fay ivy gay cath jan]
    dan:  [ivy fay dee gay hope eve jan bea cath abi]
    ed:   [jan dee bea cath fay eve abi ivy hope gay]
    fred: [bea abi dee gay eve ivy cath jan hope fay]
    gav:  [gay eve ivy bea cath abi dee hope jan fay]
    hal:  [abi eve hope fay ivy cath jan bea gay dee]
    ian:  [hope cath dee gay bea abi fay ivy jan eve]
    jon:  [abi fay jan gay eve bea dee cath ivy hope]
]
womenPrefs: #[
    abi:  [bob fred jon gav ian abe dan ed col hal]
    bea:  [bob abe col fred gav dan ian ed jon hal]
    cath: [fred bob ed gav hal col ian abe dan jon]
    dee:  [fred jon col abe ian hal gav dan bob ed]
    eve:  [jon hal fred dan abe gav col ed ian bob]
    fay:  [bob abe ed ian jon dan fred gav col hal]
    gay:  [jon gav hal fred bob abe col ed dan ian]
    hope: [gav jon bob abe ian dan hal ed col fred]
    ivy:  [ian col hal gav fred bob abe ed jon dan]
    jan:  [ed hal gav abe bob jon col ian fred dan]
]

loop keys menPrefs 'm -> menPrefs\[m]: to [:string] menPrefs\[m]
loop keys womenPrefs 'w -> womenPrefs\[w]: to [:string] womenPrefs\[w]

prefers?: function [woman, man, other]->
    (index womenPrefs\[woman] man) < index womenPrefs\[woman] other

match: function [][
    fiance: #[]
    proposals: #[]
    loop keys menPrefs 'm -> proposals\[m]: 0
    free: keys menPrefs
    while [not? empty? free][
        man: first free
        free: drop free
        woman: menPrefs\[man]\[proposals\[man]]
        proposals\[man]: inc proposals\[man]
        switch key? fiance woman [
            current: fiance\[woman]
            switch prefers? woman man current [
                fiance\[woman]: man
                'free ++ current
            ][
                'free ++ man
            ]
        ][
            fiance\[woman]: man
        ]
    ]
    fiance
]

stable?: function [husband][
    wifeOf: #[]
    loop keys husband 'w -> wifeOf\[husband\[w]]: w
    every? keys wifeOf 'man [
        prefs: menPrefs\[man]
        better: take prefs index prefs wifeOf\[man]
        rival: select better 'woman -> prefers? woman man husband\[woman]
        unless empty? rival ->
            print ["   " man "and" first rival "would rather be together"]
        empty? rival
    ]
]

engagements: match
print "Engagements:"
loop sort keys engagements 'w -> print ["   " w "-" engagements\[w]]
print ["Stable?" stable? engagements]

print ""
print "Swapping the partners of abi and bea..."
tmp: engagements\abi
engagements\abi: engagements\bea
engagements\bea: tmp
print ["Stable?" stable? engagements]
