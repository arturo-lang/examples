lempelZiv: function [s][
    components: []
    n: size s
    i: 0
    while [i < n][
        k: 1
        while [and? -> (i + k) =< n
                    -> contains? slice s 0 (i + k) - 2 slice s i (i + k) - 1] ->
            k: inc k
        'components ++ slice s i min @[(i + k) - 1, dec n]
        i: i + k
    ]
    components
]

tests: [
    "AZSEDRFTGYGUJIJOKB"
    "ABCABCABCABCABCABC"
    "111011111001111011111001"
    "101001010010111110"
    "1001111011000010"
    "1010101010"
    "1010101010101010"
    "1001111011000010000010"
    "100111101100001000001010"
    "0001101001000101"
    "1111111"
    "0001"
    "010"
    "1"
    ""
    "01011010001101110010"
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
]

print [pad "String" 32 "LZ" " Substrings"]
loop tests 's [
    c: lempelZiv s
    print [pad s 32 pad to :string size c 3 join.with:"." c]
]
